rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Validation Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connectivity Test
    match /test/connection {
      allow read: if true;
    }

    // Users collection and subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      match /investigations/{investigationId} {
        allow read, write: if isOwner(userId) && isValidId(investigationId);
      }

      match /projects/{projectSessionId} {
        allow read, write: if isOwner(userId) && isValidId(projectSessionId);
      }
    }
  }
}
